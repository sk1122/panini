NODE_ENV=development
PORT=4141
HOST=127.0.0.1
PANINI_PUBLIC_URL=http://127.0.0.1:4141
PANINI_TRUST_PROXY=false
# Production install: node scripts/selfhost.mjs init (generates a private .env).
# For an existing database, set its CURRENT password. Changing this does not rotate PostgreSQL.
POSTGRES_PASSWORD=
# Optional HTTPS overlay:
PANINI_DOMAIN=
ACME_EMAIL=
DATABASE_URL=postgres://team_ledger:team_ledger@localhost:55432/team_ledger
# Generate once with: openssl rand -base64 32
CONTENT_ENCRYPTION_KEY=
# Host-side PostgreSQL port. Containers still use PostgreSQL's internal port 5432.
POSTGRES_PORT=55432
AUTO_MIGRATE=true
APP_ADMIN_TOKEN=
APP_CONFIG_PATH=./config/panini.observation-agent.yaml
# Legacy variable name retained so existing Compose deployments continue to work.
TEAM_LEDGER_CONTAINER_CONFIG_PATH=/app/config/panini.observation-agent.yaml
NOTION_TOKEN=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_CALLBACK_URL=
JEV_WORK_ALLOWED_VISIBILITIES=
WORK_DRAFT_ALLOWED_VISIBILITIES=
WORK_STATUS_SUGGESTIONS_ENABLED=false
WORK_SUGGESTIONS_ENABLED=false
# Deliberately separate from OPENAI_API_KEY so the service never spends implicitly.
INTELLIGENCE_API_KEY=
INTELLIGENCE_MODEL=gpt-6-luna
INTELLIGENCE_BASE_URL=https://api.openai.com/v1
PANINI_EVIDENCE_V2_ENABLED=false
PANINI_EVIDENCE_V2_VERSION=
PANINI_EVIDENCE_V2_BUDGET_ID=
# Optional overrides. By default adjudication reuses the intelligence credentials and endpoint.
ADJUDICATION_API_KEY=
ADJUDICATION_MODEL=
ADJUDICATION_BASE_URL=
# Jev runs through OpenRouter Decisions and reranks authorized accepted context.
# With OpenRouter embeddings enabled,
# vectors shortlist accepted files first; failures retain Jev/lexical fallback.
# External text transfer is opt-in. Keep the shared OpenRouter key in this ignored .env file.
RETRIEVAL_PROVIDER=postgres
# Opt in to a rebuildable index of accepted context files. The worker sends
# document chunks to OpenRouter; proposals and raw source events are excluded.
EMBEDDING_PROVIDER=disabled
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=voyageai/voyage-4
