{
	"name": "panini-work",
	"version": "0.1.0",
	"description": "The grammar of work for people and agents.",
	"type": "module",
	"private": false,
	"license": "MIT",
	"bin": {
		"panini": "scripts/panini.mjs",
		"panini-relay": "dist/src/relay/cli.js",
		"panini-setup": "dist/src/setup/cli.js"
	},
	"files": [
		"scripts/panini.mjs",
		"scripts/selfhost.mjs",
		"Dockerfile",
		"compose.yaml",
		"compose.https.yaml",
		"pnpm-lock.yaml",
		"package-assets/pnpm-lock.yaml",
		"pnpm-workspace.yaml",
		"tsconfig.json",
		"src",
		"dist",
		"drizzle",
		"public",
		"integrations",
		"config/Caddyfile",
		"config/panini.example.yaml",
		"config/panini.selfhost.yaml",
		"config/panini.observation-agent.yaml",
		"tsconfig.build.json"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build && node scripts/prepare-package.mjs",
		"dev": "tsx watch src/main.ts",
		"dev:worker": "tsx watch src/worker.ts",
		"start": "node dist/src/main.js",
		"server": "node dist/src/main.js",
		"worker": "node dist/src/worker.js",
		"migrate": "node dist/src/db/migrate.js",
		"replay:verify": "tsx src/replay/cli.ts",
		"replay:rebuild": "tsx src/replay/rebuild-cli.ts",
		"relay": "tsx src/relay/cli.ts",
		"setup": "tsx src/setup/cli.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --dir test",
		"test:postgres": "vitest run test/postgres.integration.test.ts",
		"test:watch": "vitest --dir test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"observation:e2e:process": "node scripts/observation-agent-e2e.mjs",
		"format": "eslint . --fix && prettier . --write",
		"format:check": "eslint . && prettier . --check",
		"budget:create": "tsx src/maintenance/create-evidence-budget.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/node": "^2.0.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@phosphor-icons/web": "2.1.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.4",
		"pg": "^8.23.0",
		"yaml": "2.8.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.15.6",
		"@typescript-eslint/parser": "^8.71.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.12.0",
		"playwright": "1.63.0",
		"prettier": "^3.9.10",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^4.0.14"
	}
}
