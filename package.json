{
  "name": "panini-work",
  "version": "0.1.0",
  "description": "The grammar of work for people and agents.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "bin": {
    "panini": "scripts/panini.mjs",
    "panini-relay": "dist/src/relay/cli.js",
    "panini-setup": "dist/src/setup/cli.js"
  },
  "files": [
    "scripts/panini.mjs",
    "scripts/selfhost.mjs",
    "Dockerfile",
    "compose.yaml",
    "compose.https.yaml",
    "pnpm-lock.yaml",
    "package-assets/pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "src",
    "dist",
    "drizzle",
    "public",
    "integrations",
    "config/Caddyfile",
    "config/panini.example.yaml",
    "config/panini.selfhost.yaml",
    "config/team-ledger.example.yaml",
    "config/panini.observation-agent.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build && node scripts/prepare-package.mjs",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/src/main.js",
    "server": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/db/migrate.js",
    "replay:verify": "tsx src/replay/cli.ts",
    "replay:rebuild": "tsx src/replay/rebuild-cli.ts",
    "replay:accepted-report": "tsx src/maintenance/report-accepted-rebuild.ts",
    "intelligence:replay": "tsx src/maintenance/replay-intelligence.ts",
    "intelligence:cost-report": "tsx src/maintenance/report-legacy-evaluation-cost.ts",
    "gold:freeze": "tsx src/maintenance/freeze-evidence-gold.ts",
    "gold:prepare-evaluation": "tsx src/maintenance/prepare-evidence-evaluation.ts",
    "gold:run-candidate": "tsx src/maintenance/run-evidence-gold-candidate.ts",
    "gold:export-candidate": "tsx src/maintenance/export-evidence-gold-predictions.ts",
    "gold:evaluate": "tsx src/maintenance/evaluate-evidence-gold.ts",
    "evidence:rollout:prepare": "tsx src/maintenance/prepare-evidence-rollout.ts",
    "evidence:e2e:process": "node scripts/evidence-state-e2e.mjs",
    "evidence:restore:snapshot": "tsx src/maintenance/snapshot-evidence-restore.ts",
    "evidence:restore:verify": "tsx src/maintenance/verify-evidence-restore.ts",
    "projections:reset": "tsx src/maintenance/reset-task-pipeline.ts",
    "relay": "tsx src/relay/cli.ts",
    "setup": "tsx src/setup/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "test:postgres": "vitest run test/postgres.integration.test.ts",
    "test:watch": "vitest --dir test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "observation:e2e:process": "node scripts/observation-agent-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/web": "2.1.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "yaml": "2.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "playwright": "1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
